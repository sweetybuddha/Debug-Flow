{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "functions": {
    "api/index.js": {
      "maxDuration": 60
    },
    "api/analyzer.py": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/api/analyzer/integrate",
      "destination": "/api/index.js"
    },
    {
      "source": "/api/analyzer-service/(.*)",
      "destination": "/api/analyzer.py/api/analyzer/$1"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
